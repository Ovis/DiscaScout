@model DiscsViewModel
@{
    ViewData["Title"] = "DiscaScout CD一覧";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var reviewablePageItems = Model.Items.Where(x => x.NeedsReview && !x.IsRented).ToArray();
    var rentablePageItems = Model.Items.Where(x => !x.IsRented).ToArray();
    var firstPagerPage = Math.Max(1, Model.PageNumber - 2);
    var lastPagerPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
    var selectedLarge = Model.GenreGroups.SingleOrDefault(x => x.Id == Model.GenreLargeId);
    var selectedMiddle = selectedLarge?.Children.SingleOrDefault(x => x.Id == Model.GenreMiddleId);
    var genreGroupsJson = System.Text.Json.JsonSerializer.Serialize(Model.GenreGroups);
}
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #20242a; }
        body { margin: 0; background: #f6f7f9; }
        main { max-width: 1380px; margin: 0 auto; padding: 24px 28px; }
        nav { display: flex; gap: 14px; margin-bottom: 18px; font-size: 14px; }
        nav a, a.filter-link { color: #165dce; text-decoration: none; }
        h1 { margin: 0 0 14px; font-size: 28px; }
        .tabs { display: flex; gap: 8px; margin-bottom: 14px; }
        .tabs a { padding: 9px 13px; border-radius: 7px; background: #e8ebef; color: #273142; text-decoration: none; font-weight: 650; }
        .tabs a.active { background: #273142; color: white; }
        .filters { display: flex; gap: 10px; align-items: flex-start; flex-wrap: wrap; background: white; border: 1px solid #dfe3e8; border-radius: 9px; padding: 12px; margin-bottom: 12px; }
        label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 650; }
        label.checkbox { flex-direction: row; align-items: center; gap: 5px; padding-bottom: 8px; white-space: nowrap; }
        .title-filter { display: flex; flex-direction: column; gap: 5px; }
        .title-options { display: flex; gap: 10px; flex-wrap: wrap; }
        .title-options label.checkbox { padding-bottom: 0; font-weight: 500; }
        .format-filters { margin-top: 19px; }
        .format-filters summary { cursor: pointer; font-size: 12px; font-weight: 650; padding: 8px 10px; border: 1px solid #c9ced6; border-radius: 6px; background: #f6f7f9; white-space: nowrap; }
        .format-filters[open] summary { margin-bottom: 7px; }
        .format-options { display: flex; gap: 10px; padding: 8px 10px; border: 1px solid #dfe3e8; border-radius: 6px; background: #fff; position: absolute; z-index: 10; }
        .format-options label.checkbox { padding-bottom: 0; font-weight: 500; }
        input[type=text], select { padding: 8px; border: 1px solid #c9ced6; border-radius: 6px; background: white; }
        input[type=text] { width: 230px; }
        select.genre { min-width: 160px; }
        .genre-filters { display: flex; gap: 7px; }
        .filters > button { margin-top: 19px; }
        button { border: 0; border-radius: 6px; padding: 8px 12px; background: #273142; color: white; font-weight: 650; cursor: pointer; }
        button:disabled { opacity: .45; cursor: not-allowed; }
        button.secondary { background: #5f6b7a; }
        button.rented { background: #7b3fa1; }
        button.bulk { background: #165dce; }
        .status { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; padding: 10px 12px; background: #eef4ff; border: 1px solid #cbdcff; border-radius: 7px; }
        .status form { margin: 0; }
        .toolbar { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 12px; }
        .disc-list { display: flex; flex-direction: column; gap: 8px; }
        .disc { display: grid; grid-template-columns: 28px 92px minmax(0, 1fr) auto; gap: 12px; min-height: 118px; background: white; border: 1px solid #dfe3e8; border-radius: 8px; padding: 10px; }
        .select-disc { display: flex; align-items: flex-start; justify-content: center; padding-top: 36px; }
        .select-disc input { width: 18px; height: 18px; }
        .jacket { width: 92px; height: 92px; object-fit: contain; background: #f0f2f5; border-radius: 5px; }
        .no-image { width: 92px; height: 92px; display: grid; place-items: center; background: #eef0f3; color: #858d98; font-size: 11px; border-radius: 5px; }
        .title { font-size: 17px; font-weight: 750; margin-bottom: 4px; }
        .title a { color: #20242a; text-decoration: none; }
        .title a:hover, a.filter-link:hover { text-decoration: underline; }
        .artist { font-size: 14px; margin-bottom: 6px; }
        .meta { color: #68707c; font-size: 12px; line-height: 1.7; }
        .badges { display: flex; gap: 5px; flex-wrap: wrap; margin: 5px 0; }
        .badge { font-size: 10px; font-weight: 750; padding: 3px 6px; border-radius: 999px; background: #e9edf2; }
        .badge.reason { background: #fff0cc; }
        .badge.pickup { background: #e8dcff; }
        .badge.rented { background: #e5f6ea; }
        .badge.archived { background: #f2dede; }
        .badge.format { background: #dceeff; }
        .badge.release { background: #dff3e4; }
        .actions { display: flex; flex-direction: column; gap: 6px; align-items: stretch; min-width: 112px; }
        .actions button, .actions a { width: 100%; box-sizing: border-box; text-align: center; }
        .actions a { display: block; padding: 8px 10px; border-radius: 6px; border: 1px solid #c9ced6; color: #273142; text-decoration: none; font-size: 12px; }
        .pager { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 16px; color: #68707c; font-size: 13px; }
        .pager-pages { display: flex; align-items: center; justify-content: flex-end; gap: 4px; flex-wrap: wrap; }
        .pager-pages a, .pager-pages .current { min-width: 32px; box-sizing: border-box; padding: 7px 9px; border: 1px solid #c9ced6; border-radius: 6px; text-align: center; text-decoration: none; }
        .pager-pages a { color: #165dce; background: white; }
        .pager-pages a:hover { background: #eef4ff; }
        .pager-pages .current { border-color: #273142; background: #273142; color: white; font-weight: 700; }
        .pager-pages .previous, .pager-pages .next { min-width: auto; }
        .pager-pages .ellipsis { padding: 0 3px; color: #858d98; }
    </style>
</head>
<body>
    <main>
        <partial name="_Navigation" />
        <h1>CD一覧</h1>

        <div class="tabs">
            <a class="@(Model.Tab == "unchecked" ? "active" : "")" href="@Model.GetTabUrl("unchecked")">未チェック @Model.UncheckedCount</a>
            <a class="@(Model.Tab == "pickup" ? "active" : "")" href="@Model.GetTabUrl("pickup")">★ ピックアップ @Model.PickupCount</a>
            <a class="@(Model.Tab == "rented" ? "active" : "")" href="@Model.GetTabUrl("rented")">レンタル済み @Model.RentedCount</a>
            <a class="@(Model.Tab == "all" ? "active" : "")" href="@Model.GetTabUrl("all")">全件</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="status">
                <span>@Model.StatusMessage</span>
                @if (!string.IsNullOrWhiteSpace(Model.UndoPayload))
                {
                    <form method="post" asp-controller="Discs" asp-action="Undo">
                        <input type="hidden" name="undoPayload" value="@Model.UndoPayload" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="secondary" type="submit">元に戻す</button>
                    </form>
                }
            </div>
        }

        <form method="get" action="/discs" class="filters">
            <input type="hidden" name="tab" value="@Model.Tab" />
            @if (Model.Tab == "unchecked")
            {
                <label>
                    未チェック絞り込み
                    <select name="uncheckedFilter">
                        <option value="all" selected="@(Model.UncheckedFilter == "all")">すべて</option>
                        <option value="upcoming" selected="@(Model.UncheckedFilter == "upcoming")">近日リリース</option>
                        <option value="new" selected="@(Model.UncheckedFilter == "new")">新着</option>
                        <option value="artist-watch" selected="@(Model.UncheckedFilter == "artist-watch")">Artist Watch</option>
                    </select>
                </label>
            }
            <div class="title-filter">
                <label>キーワード<input type="text" name="title" value="@Model.TitleSearch" placeholder="タイトルから検索" /></label>
                <div class="title-options">
                    <label class="checkbox"><input type="checkbox" name="searchDescription" value="true" checked="@Model.SearchDescription" /> 作品詳細も検索</label>
                    <label class="checkbox"><input type="checkbox" name="searchTracks" value="true" checked="@Model.SearchTracks" /> 曲目も検索</label>
                </div>
            </div>
            <label>アーティスト<input type="text" name="artist" value="@Model.ArtistSearch" /></label>
            <div class="genre-filters">
                <label>
                    大ジャンル
                    <select class="genre" name="genreLarge" id="genre-large">
                        <option value="">すべて</option>
                        @foreach (var genre in Model.GenreGroups)
                        {
                            <option value="@genre.Id" selected="@(Model.GenreLargeId == genre.Id)">@genre.Name@(genre.IsActive ? "" : "（旧）")</option>
                        }
                    </select>
                </label>
                <label>
                    中ジャンル
                    <select class="genre" name="genreMiddle" id="genre-middle" disabled="@(selectedLarge is null)">
                        <option value="">すべて</option>
                        @if (selectedLarge is not null)
                        {
                            @foreach (var genre in selectedLarge.Children)
                            {
                                <option value="@genre.Id" selected="@(Model.GenreMiddleId == genre.Id)">@genre.Name@(genre.IsActive ? "" : "（旧）")</option>
                            }
                        }
                    </select>
                </label>
                <label>
                    小ジャンル
                    <select class="genre" name="genreSmall" id="genre-small" disabled="@(selectedMiddle is null)">
                        <option value="">すべて</option>
                        @if (selectedMiddle is not null)
                        {
                            @foreach (var genre in selectedMiddle.Children)
                            {
                                <option value="@genre.Id" selected="@(Model.GenreSmallId == genre.Id)">@genre.Name@(genre.IsActive ? "" : "（旧）")</option>
                            }
                        }
                    </select>
                </label>
            </div>
            <details class="format-filters">
                <summary>形式フィルタ@(Model.ExcludeMaxi || Model.ExcludeAlbum ? "（設定あり）" : "")</summary>
                <div class="format-options">
                    <label class="checkbox"><input type="checkbox" name="excludeMaxi" value="true" checked="@Model.ExcludeMaxi" /> MAXIを除外</label>
                    <label class="checkbox"><input type="checkbox" name="excludeAlbum" value="true" checked="@Model.ExcludeAlbum" /> アルバムを除外</label>
                </div>
            </details>
            <label>
                レンタル状態
                <select name="rental">
                    <option value="all" selected="@(Model.Rental == "all")">すべて</option>
                    <option value="unrented" selected="@(Model.Rental == "unrented")">未レンタル</option>
                    <option value="rented" selected="@(Model.Rental == "rented")">借りた</option>
                </select>
            </label>
            <label>
                並び順
                <select name="sort">
                    <option value="updated" selected="@(Model.Sort == "updated")">更新日時</option>
                    <option value="rental" selected="@(Model.Sort == "rental")">レンタル開始日</option>
                    <option value="title" selected="@(Model.Sort == "title")">タイトル</option>
                    <option value="artist" selected="@(Model.Sort == "artist")">アーティスト</option>
                </select>
            </label>
            <label>
                方向
                <select name="order">
                    <option value="desc" selected="@(Model.Order == "desc")">降順</option>
                    <option value="asc" selected="@(Model.Order == "asc")">昇順</option>
                </select>
            </label>
            <label>
                件数
                <select name="size" id="page-size">
                    <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    <option value="100" selected="@(Model.PageSize == 100)">100</option>
                    <option value="200" selected="@(Model.PageSize == 200)">200</option>
                </select>
            </label>
            <button type="submit">適用</button>
        </form>

        @if (reviewablePageItems.Length > 0 || rentablePageItems.Length > 0)
        {
            <div class="toolbar">
                @if (reviewablePageItems.Length > 0)
                {
                    <form method="post" asp-controller="Discs" asp-action="ReviewPage" onsubmit="return confirm('現在ページの未チェック @reviewablePageItems.Length 件をすべて確認済みにしますか？');">
                        @foreach (var d in reviewablePageItems)
                        {
                            <input type="hidden" name="ids" value="@d.Id" />
                        }
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <button class="bulk" type="submit">このページの未チェックをすべて確認済み</button>
                    </form>
                }
                @if (rentablePageItems.Length > 0)
                {
                    <button type="button" class="rented" id="rent-selected" disabled>選択したCDを借りた</button>
                }
            </div>
        }

        <form method="post" asp-controller="Discs" asp-action="RentSelected" id="bulk-rent-form" onsubmit="return confirm(document.querySelectorAll('.disc-select:checked').length+' 件を借りた状態にしますか？');">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="disc-list">
                @foreach (var disc in Model.Items)
                {
                    var pickup = DiscsViewModel.GetPickupArtists(disc);
                    var release = DiscsViewModel.GetRentalCategoryLabel(disc.RentalStartDate);
                    var genrePath = DiscsViewModel.GetGenrePath(disc);

                    <article class="disc">
                        <div class="select-disc">
                            @if (!disc.IsRented)
                            {
                                <input class="disc-select" type="checkbox" name="ids" value="@disc.Id" aria-label="@disc.Title を選択" />
                            }
                        </div>
                        <div>
                            @if (!string.IsNullOrWhiteSpace(disc.ImagePath))
                            {
                                <img class="jacket" src="/disc-image/@disc.Id" alt="" loading="lazy" />
                            }
                            else
                            {
                                <div class="no-image">NO IMAGE</div>
                            }
                        </div>
                        <div>
                            <div class="title"><a href="/discs/@disc.Id?returnUrl=@Uri.EscapeDataString(returnUrl)">@disc.Title</a></div>
                            <div class="artist"><a class="filter-link" href="@Model.GetArtistUrl(disc.Artist)">@disc.Artist</a></div>
                            <div class="badges">
                                @foreach (var reason in disc.ReviewReasons.OrderBy(x => x.CreatedAt))
                                {
                                    <span class="badge reason">@DiscsViewModel.FormatReviewReason(reason.Reason)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(pickup)) { <span class="badge pickup">★ @pickup</span> }
                                @if (!string.IsNullOrWhiteSpace(release)) { <span class="badge release">@release</span> }
                                @if (disc.IsMaxiSingle) { <span class="badge format">MAXI</span> }
                                @if (disc.IsTwoDisc == true) { <span class="badge format">2枚組</span> }
                                @if (disc.IsRented) { <span class="badge rented">借りた</span> }
                                @if (disc.IsArchived) { <span class="badge archived">ARCHIVED</span> }
                            </div>
                            <div class="meta">
                                @if (genrePath.Count == 0)
                                {
                                    <text>ジャンル未解決</text>
                                }
                                else
                                {
                                    @for (var depth = 0; depth < genrePath.Count; depth++)
                                    {
                                        if (depth > 0) { <text> / </text> }
                                        <a class="filter-link" href="@Model.GetGenreUrl(genrePath, depth)">@genrePath[depth].Name</a>
                                    }
                                }
                                <br />レンタル開始: @(disc.RentalStartDate?.ToString("yyyy-MM-dd") ?? "-") / DISCAS ID: @disc.DiscasId
                            </div>
                        </div>
                        <div class="actions">
                            <a href="@disc.ProductUrl" target="_blank" rel="noopener noreferrer">DISCAS</a>
                            @if (disc.NeedsReview && !disc.IsRented)
                            {
                                <button type="submit" formaction="/discs/reviewed" name="id" value="@disc.Id">確認済み</button>
                            }
                            else if (!disc.IsRented)
                            {
                                <button class="secondary" type="submit" formaction="/discs/reopen" name="id" value="@disc.Id">未チェックへ</button>
                            }
                            @if (!disc.IsRented)
                            {
                                <button class="rented" type="submit" formaction="/discs/rented" name="id" value="@disc.Id">借りた</button>
                            }
                        </div>
                    </article>
                }
            </div>
        </form>

        <div class="pager">
            <span>@Model.TotalCount 件 / @Model.PageNumber / @Model.TotalPages ページ</span>
            @if (Model.TotalPages > 1)
            {
                <span class="pager-pages" aria-label="ページ選択">
                    @if (Model.PageNumber > 1)
                    {
                        <a class="previous" href="@Model.GetPageUrl(Model.PageNumber - 1)">‹ 前</a>
                    }
                    @if (firstPagerPage > 1)
                    {
                        <a href="@Model.GetPageUrl(1)">1</a>
                        if (firstPagerPage > 2) { <span class="ellipsis" aria-hidden="true">…</span> }
                    }
                    @for (var pageNumber = firstPagerPage; pageNumber <= lastPagerPage; pageNumber++)
                    {
                        if (pageNumber == Model.PageNumber)
                        {
                            <span class="current" aria-current="page">@(pageNumber)</span>
                        }
                        else
                        {
                            <a href="@Model.GetPageUrl(pageNumber)">@(pageNumber)</a>
                        }
                    }
                    @if (lastPagerPage < Model.TotalPages)
                    {
                        if (lastPagerPage < Model.TotalPages - 1) { <span class="ellipsis" aria-hidden="true">…</span> }
                        <a href="@Model.GetPageUrl(Model.TotalPages)">@Model.TotalPages</a>
                    }
                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a class="next" href="@Model.GetPageUrl(Model.PageNumber + 1)">次 ›</a>
                    }
                </span>
            }
        </div>
    </main>
    <script>
        const size = document.getElementById('page-size');
        const saved = localStorage.getItem('discascout-page-size');
        const url = new URL(location.href);
        if (saved && ['50', '100', '200'].includes(saved) && !url.searchParams.has('size')) {
            url.searchParams.set('size', saved);
            location.replace(url.toString());
        }
        size.addEventListener('change', () => localStorage.setItem('discascout-page-size', size.value));

        const bulkButton = document.getElementById('rent-selected');
        const form = document.getElementById('bulk-rent-form');
        const checks = [...document.querySelectorAll('.disc-select')];
        const updateBulk = () => {
            if (bulkButton) bulkButton.disabled = !checks.some(x => x.checked);
        };
        checks.forEach(x => x.addEventListener('change', updateBulk));
        if (bulkButton) bulkButton.addEventListener('click', () => form.requestSubmit());

        const genreGroups = @Html.Raw(genreGroupsJson);
        const genreLarge = document.getElementById('genre-large');
        const genreMiddle = document.getElementById('genre-middle');
        const genreSmall = document.getElementById('genre-small');

        // フィルター適用のためにページを再読み込みしなくても階層を選べるよう、
        // 大・中ジャンルの変更時にサーバーから埋め込んだマスター階層で子候補を再構築する。
        const replaceGenreOptions = (select, genres) => {
            if (!select) return;
            select.replaceChildren(new Option('すべて', ''));
            for (const genre of genres) {
                select.add(new Option(`${genre.Name}${genre.IsActive ? '' : '（旧）'}`, String(genre.Id)));
            }
            select.disabled = genres.length === 0;
        };

        genreLarge?.addEventListener('change', () => {
            const large = genreGroups.find(x => String(x.Id) === genreLarge.value);
            replaceGenreOptions(genreMiddle, large?.Children ?? []);
            replaceGenreOptions(genreSmall, []);
        });
        genreMiddle?.addEventListener('change', () => {
            const large = genreGroups.find(x => String(x.Id) === genreLarge?.value);
            const middle = large?.Children.find(x => String(x.Id) === genreMiddle.value);
            replaceGenreOptions(genreSmall, middle?.Children ?? []);
        });
    </script>
</body>
</html>