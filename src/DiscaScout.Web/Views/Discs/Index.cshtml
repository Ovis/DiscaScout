@model DiscsViewModel
@{
    ViewData["Title"] = "DiscaScout CD一覧";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var reviewablePageItems = Model.Items.Where(x => x.NeedsReview && !x.IsRented).ToArray();
    var rentablePageItems = Model.Items.Where(x => !x.IsRented).ToArray();
}
<!doctype html><html lang="ja"><head><meta charset="utf-8" /><title>@ViewData["Title"]</title><style>
:root{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:#20242a}body{margin:0;background:#f6f7f9}main{max-width:1380px;margin:0 auto;padding:24px 28px}nav{display:flex;gap:14px;margin-bottom:18px;font-size:14px}nav a,a.filter-link{color:#165dce;text-decoration:none}h1{margin:0 0 14px;font-size:28px}.tabs{display:flex;gap:8px;margin-bottom:14px}.tabs a{padding:9px 13px;border-radius:7px;background:#e8ebef;color:#273142;text-decoration:none;font-weight:650}.tabs a.active{background:#273142;color:white}.filters{display:flex;gap:10px;align-items:end;flex-wrap:wrap;background:white;border:1px solid #dfe3e8;border-radius:9px;padding:12px;margin-bottom:12px}label{display:flex;flex-direction:column;gap:4px;font-size:12px;font-weight:650}label.checkbox{flex-direction:row;align-items:center;gap:5px;padding-bottom:8px;white-space:nowrap}input[type=text],select{padding:8px;border:1px solid #c9ced6;border-radius:6px;background:white}input[type=text]{width:230px}select.genre{min-width:180px}button{border:0;border-radius:6px;padding:8px 12px;background:#273142;color:white;font-weight:650;cursor:pointer}button:disabled{opacity:.45;cursor:not-allowed}button.secondary{background:#5f6b7a}button.rented{background:#7b3fa1}button.bulk{background:#165dce}.status{display:flex;align-items:center;gap:10px;margin-bottom:14px;padding:10px 12px;background:#eef4ff;border:1px solid #cbdcff;border-radius:7px}.status form{margin:0}.toolbar{display:flex;justify-content:flex-end;gap:8px;margin-bottom:12px}.disc-list{display:flex;flex-direction:column;gap:8px}.disc{display:grid;grid-template-columns:28px 92px minmax(0,1fr) auto;gap:12px;min-height:118px;background:white;border:1px solid #dfe3e8;border-radius:8px;padding:10px}.select-disc{display:flex;align-items:flex-start;justify-content:center;padding-top:36px}.select-disc input{width:18px;height:18px}.jacket{width:92px;height:92px;object-fit:contain;background:#f0f2f5;border-radius:5px}.no-image{width:92px;height:92px;display:grid;place-items:center;background:#eef0f3;color:#858d98;font-size:11px;border-radius:5px}.title{font-size:17px;font-weight:750;margin-bottom:4px}.title a{color:#20242a;text-decoration:none}.title a:hover,a.filter-link:hover{text-decoration:underline}.artist{font-size:14px;margin-bottom:6px}.meta{color:#68707c;font-size:12px;line-height:1.7}.badges{display:flex;gap:5px;flex-wrap:wrap;margin:5px 0}.badge{font-size:10px;font-weight:750;padding:3px 6px;border-radius:999px;background:#e9edf2}.badge.reason{background:#fff0cc}.badge.pickup{background:#e8dcff}.badge.rented{background:#e5f6ea}.badge.archived{background:#f2dede}.badge.format{background:#dceeff}.badge.release{background:#dff3e4}.actions{display:flex;flex-direction:column;gap:6px;align-items:stretch;min-width:112px}.actions button,.actions a{width:100%;box-sizing:border-box;text-align:center}.actions a{display:block;padding:8px 10px;border-radius:6px;border:1px solid #c9ced6;color:#273142;text-decoration:none;font-size:12px}.pager{display:flex;justify-content:space-between;margin-top:16px;color:#68707c;font-size:13px}.pager a{color:#165dce;text-decoration:none}
</style></head><body><main>
<partial name="_Navigation" /><h1>CD一覧</h1>
<div class="tabs"><a class="@(Model.Tab=="unchecked"?"active":"")" href="@Model.GetTabUrl("unchecked")">未チェック @Model.UncheckedCount</a><a class="@(Model.Tab=="pickup"?"active":"")" href="@Model.GetTabUrl("pickup")">★ ピックアップ @Model.PickupCount</a><a class="@(Model.Tab=="all"?"active":"")" href="@Model.GetTabUrl("all")">全件</a></div>
@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="status"><span>@Model.StatusMessage</span>@if(!string.IsNullOrWhiteSpace(Model.UndoPayload)){<form method="post" asp-controller="Discs" asp-action="Undo"><input type="hidden" name="undoPayload" value="@Model.UndoPayload"/><input type="hidden" name="returnUrl" value="@returnUrl"/><button class="secondary" type="submit">元に戻す</button></form>}</div>}
<form method="get" action="/discs" class="filters"><input type="hidden" name="tab" value="@Model.Tab"/><label>タイトル<input type="text" name="title" value="@Model.TitleSearch"/></label><label>アーティスト<input type="text" name="artist" value="@Model.ArtistSearch"/></label><label>ジャンル<select class="genre" name="genre"><option value="">すべて</option>@foreach(var lg in Model.GenreGroups){<optgroup label="@lg.Name"><option value="@lg.Name" selected="@(Model.Genre==lg.Name)">@lg.Name（すべて）</option>@foreach(var mg in lg.MiddleGenres){<option value="@mg.Name" selected="@(Model.Genre==mg.Name)">　├ @mg.Name</option>@foreach(var sg in mg.SmallGenres){<option value="@sg" selected="@(Model.Genre==sg)">　│　└ @sg</option>}}</optgroup>}</select></label><label class="checkbox"><input type="checkbox" name="excludeMaxi" value="true" checked="@Model.ExcludeMaxi"/> MAXIを除外</label><label class="checkbox"><input type="checkbox" name="excludeAlbum" value="true" checked="@Model.ExcludeAlbum"/> アルバムを除外</label><label>レンタル状態<select name="rental"><option value="all" selected="@(Model.Rental=="all")">すべて</option><option value="unrented" selected="@(Model.Rental=="unrented")">未レンタル</option><option value="rented" selected="@(Model.Rental=="rented")">借りた</option></select></label><label>並び順<select name="sort"><option value="updated" selected="@(Model.Sort=="updated")">更新が新しい順</option><option value="rental" selected="@(Model.Sort=="rental")">レンタル開始日順</option><option value="title" selected="@(Model.Sort=="title")">タイトル順</option><option value="artist" selected="@(Model.Sort=="artist")">アーティスト順</option></select></label><label>件数<select name="size" id="page-size"><option value="50" selected="@(Model.PageSize==50)">50</option><option value="100" selected="@(Model.PageSize==100)">100</option><option value="200" selected="@(Model.PageSize==200)">200</option></select></label><button type="submit">適用</button></form>
@if(reviewablePageItems.Length>0||rentablePageItems.Length>0){<div class="toolbar">@if(reviewablePageItems.Length>0){<form method="post" asp-controller="Discs" asp-action="ReviewPage" onsubmit="return confirm('現在ページの未チェック @reviewablePageItems.Length 件をすべて確認済みにしますか？');">@foreach(var d in reviewablePageItems){<input type="hidden" name="ids" value="@d.Id"/>}<input type="hidden" name="returnUrl" value="@returnUrl"/><button class="bulk" type="submit">このページの未チェックをすべて確認済み</button></form>}@if(rentablePageItems.Length>0){<button type="button" class="rented" id="rent-selected" disabled>選択したCDを借りた</button>}</div>}
<form method="post" asp-controller="Discs" asp-action="RentSelected" id="bulk-rent-form" onsubmit="return confirm(document.querySelectorAll('.disc-select:checked').length+' 件を借りた状態にしますか？');"><input type="hidden" name="returnUrl" value="@returnUrl"/><div class="disc-list">@foreach(var disc in Model.Items){var pickup=DiscsViewModel.GetPickupArtists(disc);var release=DiscsViewModel.GetRentalCategoryLabel(disc.RentalStartDate);<article class="disc"><div class="select-disc">@if(!disc.IsRented){<input class="disc-select" type="checkbox" name="ids" value="@disc.Id" aria-label="@disc.Title を選択"/>}</div><div>@if(!string.IsNullOrWhiteSpace(disc.ImagePath)){<img class="jacket" src="/disc-image/@disc.Id" alt="" loading="lazy"/>}else{<div class="no-image">NO IMAGE</div>}</div><div><div class="title"><a href="/discs/@disc.Id?returnUrl=@Uri.EscapeDataString(returnUrl)">@disc.Title</a></div><div class="artist"><a class="filter-link" href="@Model.GetArtistUrl(disc.Artist)">@disc.Artist</a></div><div class="badges">@foreach(var reason in disc.ReviewReasons.OrderBy(x=>x.CreatedAt)){<span class="badge reason">@DiscsViewModel.FormatReviewReason(reason.Reason)</span>}@if(!string.IsNullOrWhiteSpace(pickup)){<span class="badge pickup">★ @pickup</span>}@if(!string.IsNullOrWhiteSpace(release)){<span class="badge release">@release</span>}@if(disc.IsMaxiSingle){<span class="badge format">MAXI</span>}@if(disc.IsTwoDisc==true){<span class="badge format">2枚組</span>}@if(disc.IsRented){<span class="badge rented">借りた</span>}@if(disc.IsArchived){<span class="badge archived">ARCHIVED</span>}</div><div class="meta"><a class="filter-link" href="@Model.GetGenreUrl(disc.GenreLarge)">@disc.GenreLarge</a>@if(!string.IsNullOrWhiteSpace(disc.GenreMiddle)){<text> / <a class="filter-link" href="@Model.GetGenreUrl(disc.GenreMiddle)">@disc.GenreMiddle</a></text>}@if(!string.IsNullOrWhiteSpace(disc.GenreSmall)){<text> / <a class="filter-link" href="@Model.GetGenreUrl(disc.GenreSmall)">@disc.GenreSmall</a></text>}<br/>レンタル開始: @(disc.RentalStartDate?.ToString("yyyy-MM-dd")??"-") / DISCAS ID: @disc.DiscasId</div></div><div class="actions"><a href="@disc.ProductUrl" target="_blank" rel="noopener noreferrer">DISCAS</a>@if(disc.NeedsReview&&!disc.IsRented){<button type="submit" formaction="/discs/reviewed" name="id" value="@disc.Id">確認済み</button>}else if(!disc.IsRented){<button class="secondary" type="submit" formaction="/discs/reopen" name="id" value="@disc.Id">未チェックへ</button>}@if(!disc.IsRented){<button class="rented" type="submit" formaction="/discs/rented" name="id" value="@disc.Id">借りた</button>}</div></article>}</div></form>
<div class="pager"><span>@Model.TotalCount 件 / @Model.PageNumber / @Model.TotalPages ページ</span><span>@if(Model.PageNumber>1){<a href="@Model.GetPageUrl(Model.PageNumber-1)">← 前</a>}@if(Model.PageNumber<Model.TotalPages){<text>&nbsp;&nbsp;</text><a href="@Model.GetPageUrl(Model.PageNumber+1)">次 →</a>}</span></div>
</main><script>const size=document.getElementById('page-size');const saved=localStorage.getItem('discascout-page-size');const url=new URL(location.href);if(saved&&['50','100','200'].includes(saved)&&!url.searchParams.has('size')){url.searchParams.set('size',saved);location.replace(url.toString())}size.addEventListener('change',()=>localStorage.setItem('discascout-page-size',size.value));const bulkButton=document.getElementById('rent-selected');const form=document.getElementById('bulk-rent-form');const checks=[...document.querySelectorAll('.disc-select')];const updateBulk=()=>{if(bulkButton)bulkButton.disabled=!checks.some(x=>x.checked)};checks.forEach(x=>x.addEventListener('change',updateBulk));if(bulkButton)bulkButton.addEventListener('click',()=>form.requestSubmit());</script></body></html>
