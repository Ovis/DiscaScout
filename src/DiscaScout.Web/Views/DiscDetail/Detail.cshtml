@model DiscDetailViewModel
@{
    ViewData["Title"] = $"{Model.Disc.Title} - DiscaScout";
    var backUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : "/discs";
    var rentalCategory = DiscDetailViewModel.FormatRentalCategory(Model.Disc.RentalStartDate);
}
<!doctype html><html lang="ja"><head><meta charset="utf-8"/><title>@ViewData["Title"]</title><style>
:root{font-family:system-ui,-apple-system,"Segoe UI",sans-serif;color:#20242a}body{margin:0;background:#f6f7f9}main{max-width:1180px;margin:0 auto;padding:24px 28px 48px}nav{display:flex;gap:14px;margin-bottom:18px;font-size:14px}nav a,a{color:#165dce;text-decoration:none}h1{margin:0;font-size:27px;line-height:1.35}h2{margin:0 0 12px;font-size:18px}.back{margin-bottom:14px}.status{margin-bottom:14px;padding:10px 12px;background:#eef4ff;border:1px solid #cbdcff;border-radius:7px}.hero{display:grid;grid-template-columns:220px minmax(0,1fr);gap:24px;background:white;border:1px solid #dfe3e8;border-radius:10px;padding:18px;margin-bottom:16px}.hero-content{position:relative;padding-right:130px}.detail-maintenance{position:absolute;top:0;right:0;margin:0}.jacket{width:220px;height:220px;object-fit:contain;background:#f0f2f5;border-radius:6px}.no-image{width:220px;height:220px;display:grid;place-items:center;background:#eef0f3;color:#858d98;border-radius:6px}.artist{font-size:17px;margin-top:6px}.badges{display:flex;gap:6px;flex-wrap:wrap;margin:12px 0}.badge{font-size:11px;font-weight:700;padding:4px 7px;border-radius:999px;background:#e9edf2}.badge.reason{background:#fff0cc}.badge.rented{background:#e5f6ea}.badge.archived{background:#f2dede}.badge.pickup{background:#e8dcff}.badge.format{background:#dceeff}.badge.release{background:#e7f0dd}.meta-grid{display:grid;grid-template-columns:150px minmax(0,1fr);gap:6px 14px;font-size:13px;margin-top:14px}.meta-grid dt{color:#68707c;font-weight:650}.meta-grid dd{margin:0;overflow-wrap:anywhere}.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}.actions form{margin:0}button,.button-link{border:0;border-radius:6px;padding:9px 13px;background:#273142;color:white;font-weight:650;cursor:pointer;font-size:13px}button.secondary{background:#5f6b7a}button.rented{background:#7b3fa1}button.warning{background:#9a5a24}.button-link{display:inline-block;box-sizing:border-box}section{background:white;border:1px solid #dfe3e8;border-radius:10px;padding:16px;margin-top:14px}.description{white-space:pre-wrap;line-height:1.75;font-size:14px}table{width:100%;border-collapse:collapse;font-size:13px}th,td{padding:8px 9px;border-bottom:1px solid #e8ebef;text-align:left;vertical-align:top}th{color:#68707c;font-size:12px}tr:last-child td{border-bottom:0}.muted{color:#7a838e}.empty{color:#7a838e;font-size:13px}.current{font-weight:700}.track-number{width:50px;text-align:right}.track-duration{width:100px}@media(max-width:760px){.hero-content{padding-right:0}.detail-maintenance{position:static;margin-bottom:12px;text-align:right}}
</style></head><body><main><partial name="_Navigation"/><div class="back"><a href="@backUrl">← 一覧へ戻る</a></div>
@if(!string.IsNullOrWhiteSpace(Model.StatusMessage)){<div class="status">@Model.StatusMessage</div>}
<article class="hero"><div>@if(!string.IsNullOrWhiteSpace(Model.Disc.DetailImageUrl)){<img class="jacket" src="@Model.Disc.DetailImageUrl" alt="" referrerpolicy="no-referrer"/>}else if(!string.IsNullOrWhiteSpace(Model.Disc.ImagePath)){<img class="jacket" src="/disc-image/@Model.Disc.Id" alt=""/>}else{<div class="no-image">NO IMAGE</div>}</div><div class="hero-content"><form class="detail-maintenance" method="post" asp-controller="DiscDetail" asp-action="RefetchDetail" asp-route-id="@Model.Disc.Id"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button class="secondary" type="submit">詳細を取り直す</button></form><h1>@Model.Disc.Title</h1><div class="artist">@Model.Disc.Artist</div><div class="badges">@foreach(var reason in Model.Disc.ReviewReasons.OrderBy(x=>x.CreatedAt)){<span class="badge reason">@DiscDetailViewModel.FormatReviewReason(reason.Reason)</span>}@if(Model.Disc.ArtistMatches.Any(x=>x.IsCurrentMatch&&!x.ArtistSetting.IsArchived&&x.ArtistSetting.IsWatchEnabled)){<span class="badge pickup">★ Pickup</span>}@if(!string.IsNullOrWhiteSpace(rentalCategory)){<span class="badge release">@rentalCategory</span>}@if(Model.Disc.IsMaxiSingle){<span class="badge format">MAXI</span>}@if(Model.Disc.IsTwoDisc==true){<span class="badge format">2枚組</span>}@if(Model.Disc.IsRented){<span class="badge rented">借りた</span>}@if(Model.Disc.IsArchived){<span class="badge archived">ARCHIVED</span>}@if(Model.Disc.NeedsReview&&!Model.Disc.IsRented){<span class="badge">未チェック</span>}</div><dl class="meta-grid"><dt>DISCAS ID</dt><dd>@Model.Disc.DiscasId</dd><dt>ジャンル</dt><dd>@Model.Disc.GenreLarge@if(!string.IsNullOrWhiteSpace(Model.Disc.GenreMiddle)){<text> / @Model.Disc.GenreMiddle</text>}@if(!string.IsNullOrWhiteSpace(Model.Disc.GenreSmall)){<text> / @Model.Disc.GenreSmall</text>}</dd><dt>マキシシングル</dt><dd>@(Model.Disc.IsMaxiSingle?"はい":"いいえ")</dd><dt>2枚組</dt><dd>@DiscDetailViewModel.FormatTwoDisc(Model.Disc.IsTwoDisc)</dd><dt>レンタル開始日</dt><dd>@(Model.Disc.RentalStartDate?.ToString("yyyy-MM-dd")??"未取得")</dd><dt>詳細情報</dt><dd>@DiscDetailViewModel.FormatDetailStatus(Model.Disc)</dd><dt>詳細最終取得</dt><dd>@DiscDetailViewModel.FormatJapanTime(Model.Disc.DetailFetchedAt)</dd><dt>初回観測</dt><dd>@DiscDetailViewModel.FormatJapanTime(Model.Disc.FirstSeenAt)</dd><dt>最終観測</dt><dd>@DiscDetailViewModel.FormatJapanTime(Model.Disc.LastSeenAt)</dd><dt>最終更新</dt><dd>@DiscDetailViewModel.FormatJapanTime(Model.Disc.LastUpdatedAt)</dd><dt>最終確認</dt><dd>@DiscDetailViewModel.FormatJapanTime(Model.Disc.LastReviewedAt)</dd></dl><div class="actions"><a class="button-link" href="@Model.Disc.ProductUrl" target="_blank" rel="noopener noreferrer">DISCASを開く</a>@if(!Model.Disc.IsRented){@if(Model.Disc.NeedsReview){<form method="post" asp-controller="DiscDetail" asp-action="Reviewed" asp-route-id="@Model.Disc.Id"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button type="submit">確認済み</button></form>}else{<form method="post" asp-controller="DiscDetail" asp-action="Reopen" asp-route-id="@Model.Disc.Id"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button class="secondary" type="submit">未チェックへ戻す</button></form>}<form method="post" asp-controller="DiscDetail" asp-action="Rented" asp-route-id="@Model.Disc.Id"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button class="rented" type="submit">借りた</button></form>}else{<form method="post" asp-controller="DiscDetail" asp-action="Unrented" asp-route-id="@Model.Disc.Id"><input type="hidden" name="returnUrl" value="@Model.ReturnUrl"/><button class="warning" type="submit">未レンタルへ戻す</button></form>}</div></div></article>
<section><h2>作品詳細</h2>@if(!string.IsNullOrWhiteSpace(Model.Disc.Description)){<div class="description">@Model.Disc.Description</div>}else if(Model.Disc.DetailFetchedAt is null){<div class="empty">詳細情報をバックグラウンドで取得します。しばらくしてから再読み込みしてください。</div>}else{<div class="empty">DISCAS側に作品詳細の記載がありません。</div>}</section>
<section><h2>曲目</h2>@if(Model.Disc.Tracks.Count>0){<table><thead><tr><th class="track-number">#</th><th>曲名</th><th class="track-duration">時間</th></tr></thead><tbody>@foreach(var track in Model.Disc.Tracks.OrderBy(x=>x.TrackNumber)){<tr><td class="track-number">@track.TrackNumber</td><td>@track.Title</td><td>@(track.Duration??"-")</td></tr>}</tbody></table>}else if(Model.Disc.DetailFetchedAt is null){<div class="empty">詳細情報をバックグラウンドで取得します。しばらくしてから再読み込みしてください。</div>}else{<div class="empty">DISCAS側に曲目の記載がありません。</div>}</section>
<section><h2>取得元</h2>@if(Model.Disc.Sources.Count==0){<div class="empty">通常リリースカテゴリでの観測履歴はありません。</div>}else{<table><thead><tr><th>カテゴリ</th><th>状態</th><th>順位</th><th>Missing</th><th>最終観測</th></tr></thead><tbody>@foreach(var source in Model.Disc.Sources.OrderBy(x=>x.Category)){<tr><td>@DiscDetailViewModel.FormatCategory(source.Category)</td><td class="@(source.IsActive?"current":"muted")">@(source.IsActive?"Active":"Inactive")</td><td>@source.SourceRank</td><td>@source.MissingCount</td><td>@DiscDetailViewModel.FormatJapanTime(source.LastSeenAt)</td></tr>}</tbody></table>}</section>
<section><h2>Artist Watch 一致履歴</h2>@if(Model.Disc.ArtistMatches.Count==0){<div class="empty">Artist Watchとの一致履歴はありません。</div>}else{<table><thead><tr><th>設定</th><th>一致条件</th><th>現在</th><th>初回一致</th><th>最終一致</th><th>不一致化</th></tr></thead><tbody>@foreach(var match in Model.Disc.ArtistMatches.OrderByDescending(x=>x.IsCurrentMatch).ThenBy(x=>x.ArtistSetting.Artist)){<tr><td>@match.ArtistSetting.Artist @if(match.ArtistSetting.IsArchived){<span class="muted">(Archived)</span>}</td><td>@match.ArtistSetting.MatchType</td><td class="@(match.IsCurrentMatch?"current":"muted")">@(match.IsCurrentMatch?"一致":"過去一致")</td><td>@DiscDetailViewModel.FormatJapanTime(match.FirstMatchedAt)</td><td>@DiscDetailViewModel.FormatJapanTime(match.LastMatchedAt)</td><td>@DiscDetailViewModel.FormatJapanTime(match.LastUnmatchedAt)</td></tr>}</tbody></table>}</section>
<section><h2>Artist Catalog 所属</h2>@if(Model.Disc.ArtistCatalogEntries.Count==0){<div class="empty">Artist Catalogからの収集履歴はありません。</div>}else{<table><thead><tr><th>設定</th><th>状態</th><th>初回観測</th><th>最終観測</th><th>Inactive化</th></tr></thead><tbody>@foreach(var entry in Model.Disc.ArtistCatalogEntries.OrderByDescending(x=>x.IsActive).ThenBy(x=>x.ArtistSetting.Artist)){<tr><td>@entry.ArtistSetting.Artist</td><td class="@(entry.IsActive?"current":"muted")">@(entry.IsActive?"Active":"Inactive")</td><td>@DiscDetailViewModel.FormatJapanTime(entry.FirstSeenAt)</td><td>@DiscDetailViewModel.FormatJapanTime(entry.LastSeenAt)</td><td>@DiscDetailViewModel.FormatJapanTime(entry.DeactivatedAt)</td></tr>}</tbody></table>}</section>
<section><h2>変更履歴</h2>@if(Model.Disc.ChangeHistory.Count==0){<div class="empty">記録対象となる変更はありません。</div>}else{<table><thead><tr><th>日時</th><th>項目</th><th>変更前</th><th>変更後</th></tr></thead><tbody>@foreach(var change in Model.Disc.ChangeHistory.OrderByDescending(x=>x.ChangedAt)){<tr><td>@DiscDetailViewModel.FormatJapanTime(change.ChangedAt)</td><td>@change.Field</td><td>@(change.OldValue??"-")</td><td>@(change.NewValue??"-")</td></tr>}</tbody></table>}</section>
</main></body></html>
