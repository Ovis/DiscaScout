@page "/artists"
@model ArtistsModel
@using DiscaScout.Core
@{
    ViewData["Title"] = "DiscaScout Artist設定";
}
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #20242a; }
        body { margin: 0; background: #f6f7f9; }
        main { max-width: 1180px; margin: 0 auto; padding: 24px 28px; }
        nav { display: flex; gap: 14px; margin-bottom: 18px; font-size: 14px; }
        nav a { color: #165dce; text-decoration: none; }
        h1 { margin: 0 0 6px; font-size: 28px; }
        h2 { margin: 0 0 12px; font-size: 19px; }
        .muted { color: #68707c; font-size: 13px; }
        .card { background: white; border: 1px solid #dfe3e8; border-radius: 9px; padding: 16px; margin-top: 16px; }
        .status { margin-top: 14px; padding: 10px 12px; background: #eef4ff; border: 1px solid #cbdcff; border-radius: 7px; }
        .form-row { display: grid; grid-template-columns: minmax(200px,1fr) 150px auto auto auto auto; gap: 10px; align-items: end; }
        label { display: flex; flex-direction: column; gap: 5px; font-size: 12px; font-weight: 650; }
        label.check { flex-direction: row; align-items: center; padding-bottom: 8px; white-space: nowrap; }
        input[type=text], select { padding: 8px; border: 1px solid #c9ced6; border-radius: 6px; background: white; }
        button { border: 0; border-radius: 6px; padding: 8px 12px; background: #273142; color: white; font-weight: 650; cursor: pointer; }
        button.primary { background: #165dce; }
        button.secondary { background: #5f6b7a; }
        button.archive { background: #8b3b3b; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 10px 8px; border-bottom: 1px solid #e6e9ed; text-align: left; vertical-align: middle; }
        th { color: #5a6470; white-space: nowrap; }
        td form { margin: 0; }
        .setting-form { display: grid; grid-template-columns: minmax(180px,1fr) 125px auto auto auto auto; gap: 8px; align-items: center; }
        .setting-form input[type=text], .setting-form select { min-width: 0; width: 100%; box-sizing: border-box; }
        .count { white-space: nowrap; color: #68707c; }
        .archived { opacity: .62; }
        .actions { display: flex; gap: 6px; margin-top: 6px; }
    </style>
</head>
<body>
<main>
    <nav><a href="/discs">CD一覧</a><a href="/artists">Artist設定</a><a href="/operations">運用</a></nav>
    <h1>Artist設定</h1>
    <div class="muted">新着Watchと全作品収集は同じArtist設定を共有します。全作品収集は手動実行時のみDISCASへアクセスします。</div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status">@Model.StatusMessage</div>
    }

    <section class="card">
        <h2>追加</h2>
        <form method="post" asp-page-handler="Add" class="form-row">
            <label>アーティスト名<input type="text" name="artist" required /></label>
            <label>一致方法
                <select name="matchType">
                    <option value="Exact">完全一致</option>
                    <option value="Contains">部分一致</option>
                </select>
            </label>
            <label class="check"><input type="checkbox" name="isWatchEnabled" value="true" checked /> 新着Watch</label>
            <label class="check"><input type="checkbox" name="collectFullCatalog" value="true" /> 全作品収集</label>
            <label class="check"><input type="checkbox" name="reopenExistingReviewedMatches" value="true" /> 既存一致を未チェックへ</label>
            <button class="primary" type="submit">追加</button>
        </form>
    </section>

    <section class="card">
        <h2>設定一覧</h2>
        @if (Model.Settings.Count == 0)
        {
            <div class="muted">Artist設定はまだありません。</div>
        }
        else
        {
            <table>
                <thead><tr><th>設定</th><th>現在一致</th><th>Catalog</th><th>操作</th></tr></thead>
                <tbody>
                @foreach (var setting in Model.Settings)
                {
                    <tr class="@(setting.IsArchived ? "archived" : "")">
                        <td>
                            @if (!setting.IsArchived)
                            {
                                <form method="post" asp-page-handler="Update" class="setting-form">
                                    <input type="hidden" name="id" value="@setting.Id" />
                                    <input type="text" name="artist" value="@setting.Artist" required />
                                    <select name="matchType">
                                        @if (setting.MatchType == ArtistMatchType.Exact) { <option value="Exact" selected>完全一致</option><option value="Contains">部分一致</option> }
                                        else { <option value="Exact">完全一致</option><option value="Contains" selected>部分一致</option> }
                                    </select>
                                    <label class="check"><input type="checkbox" name="isWatchEnabled" value="true" checked="@setting.IsWatchEnabled" /> Watch</label>
                                    <label class="check"><input type="checkbox" name="collectFullCatalog" value="true" checked="@setting.CollectFullCatalog" /> 全作品</label>
                                    <label class="check"><input type="checkbox" name="reopenExistingReviewedMatches" value="true" /> 既存を再確認</label>
                                    <button type="submit">保存</button>
                                </form>
                            }
                            else
                            {
                                <strong>@setting.Artist</strong> <span class="muted">(@setting.MatchType / アーカイブ済み)</span>
                            }
                        </td>
                        <td class="count">@setting.CurrentMatchCount 件</td>
                        <td class="count">@setting.ActiveCatalogCount 件</td>
                        <td>
                            <div class="actions">
                                @if (!setting.IsArchived && setting.CollectFullCatalog)
                                {
                                    <form method="post" asp-page-handler="Collect"><input type="hidden" name="id" value="@setting.Id" /><button class="secondary" type="submit">全作品を再取得</button></form>
                                }
                                @if (!setting.IsArchived)
                                {
                                    <form method="post" asp-page-handler="Archive"><input type="hidden" name="id" value="@setting.Id" /><button class="archive" type="submit">アーカイブ</button></form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Restore"><input type="hidden" name="id" value="@setting.Id" /><button type="submit">復元</button></form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </section>
</main>
</body>
</html>
