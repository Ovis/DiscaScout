@page "/operations"
@model OperationsModel
@using DiscaScout.Core
@{
    ViewData["Title"] = "DiscaScout 運用";
}
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme: light; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; }
        body { margin: 0; background: #f6f7f9; color: #20242a; }
        main { max-width: 1180px; margin: 0 auto; padding: 28px; }
        nav { display: flex; gap: 14px; margin-bottom: 18px; font-size: 14px; }
        nav a { color: #165dce; text-decoration: none; }
        h1 { margin: 0 0 6px; font-size: 28px; }
        h2 { margin-top: 0; font-size: 19px; }
        .muted { color: #68707c; font-size: 14px; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 22px; }
        .card { background: white; border: 1px solid #dfe3e8; border-radius: 10px; padding: 20px; }
        .full { grid-column: 1 / -1; }
        .status { margin-top: 18px; padding: 12px 14px; background: #eef4ff; border: 1px solid #cbdcff; border-radius: 8px; }
        .field-row { display: flex; gap: 12px; align-items: end; flex-wrap: wrap; }
        label { display: flex; flex-direction: column; gap: 5px; font-size: 13px; font-weight: 600; }
        input[type=time], select { min-width: 150px; padding: 8px; border: 1px solid #c9ced6; border-radius: 6px; background: white; }
        .check { flex-direction: row; align-items: center; gap: 8px; padding-bottom: 8px; }
        button { border: 0; border-radius: 6px; padding: 9px 15px; font-weight: 650; cursor: pointer; background: #273142; color: white; }
        button.primary { background: #165dce; }
        button:disabled { cursor: default; opacity: .55; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        th, td { padding: 9px 8px; border-bottom: 1px solid #e6e9ed; text-align: left; vertical-align: top; }
        th { color: #5a6470; font-weight: 650; white-space: nowrap; }
        .ok { color: #147a3d; font-weight: 700; }
        .ng { color: #b42318; font-weight: 700; }
        .warn { color: #8a5a00; font-weight: 700; }
        .running { color: #165dce; font-weight: 700; }
        .pending { color: #8a5a00; font-weight: 700; }
        .error { color: #b42318; max-width: 360px; }
        .empty { color: #68707c; padding: 12px 0 2px; }
        @@media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
<main>
    <partial name="_Navigation" />
    <h1>DiscaScout 運用</h1>
    <div class="muted">定期取得、手動取得、Retry予定、直近の実行履歴を管理します。</div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status">@Model.StatusMessage</div>
    }

    <div class="grid">
        <section class="card">
            <h2>定期取得</h2>
            <form method="post" asp-page-handler="SaveSchedule">
                <div class="field-row">
                    <label class="check">
                        <input asp-for="IsEnabled" type="checkbox" />
                        有効
                    </label>
                    <label>
                        曜日
                        <select asp-for="DayOfWeek">
                            @foreach (var option in OperationsModel.DayOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        時刻（JST）
                        <input asp-for="LocalTime" type="time" step="60" />
                    </label>
                    <button type="submit">設定を保存</button>
                </div>
                <div class="muted" style="margin-top: 12px;">
                    最終定期実行日: @(Model.LastScheduledExecutionDate?.ToString("yyyy-MM-dd") ?? "なし")
                </div>
            </form>
        </section>

        <section class="card">
            <h2>手動取得</h2>
            <p class="muted">近日リリースと新作を順番に取得します。要求後はバックグラウンドで処理するため、画面を閉じても継続します。</p>
            <form method="post" asp-page-handler="RunNow">
                @if (Model.IsFullScrapeActive)
                {
                    <button class="primary" type="submit" disabled>取得中 / 待機中</button>
                }
                else
                {
                    <button class="primary" type="submit">今すぐ取得</button>
                }
            </form>
            <p class="muted">手動要求・Retry・定期取得は同時実行せず、DISCASへのアクセスを直列化します。</p>
        </section>

        <section class="card full">
            <h2>手動処理キュー</h2>
            @if (Model.ActiveManualWork.Count == 0)
            {
                <div class="empty">保留中・実行中の手動処理はありません。</div>
            }
            else
            {
                <table>
                    <thead><tr><th>種別</th><th>状態</th><th>要求時刻（JST）</th><th>対象</th></tr></thead>
                    <tbody>
                    @foreach (var work in Model.ActiveManualWork)
                    {
                        <tr>
                            <td>@OperationsModel.GetManualWorkTypeLabel(work.Type)</td>
                            <td class="@(work.Status == ManualWorkStatus.Running ? "running" : "pending")">@(work.Status == ManualWorkStatus.Running ? "実行中" : "待機中")</td>
                            <td>@OperationsModel.ToJapanTime(work.RequestedAt).ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@OperationsModel.GetManualWorkTarget(work)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        <section class="card full">
            <h2>手動処理履歴</h2>
            @if (Model.RecentManualWork.Count == 0)
            {
                <div class="empty">手動処理履歴はまだありません。</div>
            }
            else
            {
                <table>
                    <thead><tr><th>要求（JST）</th><th>種別</th><th>状態</th><th>対象</th><th>完了（JST）</th><th>失敗理由</th></tr></thead>
                    <tbody>
                    @foreach (var work in Model.RecentManualWork)
                    {
                        <tr>
                            <td>@OperationsModel.ToJapanTime(work.RequestedAt).ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@OperationsModel.GetManualWorkTypeLabel(work.Type)</td>
                            <td class="@(work.Status == ManualWorkStatus.Completed ? "ok" : work.Status == ManualWorkStatus.Failed ? "ng" : work.Status == ManualWorkStatus.Running ? "running" : "pending")">@work.Status</td>
                            <td>@OperationsModel.GetManualWorkTarget(work)</td>
                            <td>@(work.CompletedAt.HasValue ? OperationsModel.ToJapanTime(work.CompletedAt.Value).ToString("yyyy-MM-dd HH:mm:ss") : "-")</td>
                            <td class="error">@(work.FailureReason ?? "")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        <section class="card full">
            <h2>保留中のRetry</h2>
            @if (Model.PendingRetries.Count == 0)
            {
                <div class="empty">保留中のRetryはありません。</div>
            }
            else
            {
                <table>
                    <thead><tr><th>カテゴリ</th><th>回数</th><th>予定時刻（JST）</th></tr></thead>
                    <tbody>
                    @foreach (var retry in Model.PendingRetries)
                    {
                        <tr>
                            <td>@retry.Category</td>
                            <td>@retry.AttemptNumber</td>
                            <td>@OperationsModel.ToJapanTime(retry.DueAt).ToString("yyyy-MM-dd HH:mm:ss")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>

        <section class="card full">
            <h2>実行履歴</h2>
            @if (Model.RecentRuns.Count == 0)
            {
                <div class="empty">実行履歴はまだありません。</div>
            }
            else
            {
                <table>
                    <thead>
                    <tr>
                        <th>開始（JST）</th><th>種別</th><th>カテゴリ</th><th>結果</th>
                        <th>件数</th><th>ページ</th><th>追加</th><th>更新</th><th>時間</th><th>失敗種別 / 理由</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var run in Model.RecentRuns)
                    {
                        <tr>
                            <td>@OperationsModel.ToJapanTime(run.StartedAt).ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@run.ExecutionType</td>
                            <td>@run.Category</td>
                            <td class="@(run.IsSuccess ? (run.CountDropOverrideUsed ? "warn" : "ok") : "ng")">
                                @(run.IsSuccess ? (run.CountDropOverrideUsed ? "成功（急減許可）" : "成功") : "失敗")
                            </td>
                            <td>@(run.ParsedCount?.ToString() ?? "-")</td>
                            <td>@(run.PageCount?.ToString() ?? "-")</td>
                            <td>@run.AddedCount</td>
                            <td>@run.UpdatedCount</td>
                            <td>@(TimeSpan.FromMilliseconds(run.DurationMilliseconds).ToString(@"hh\:mm\:ss"))</td>
                            <td class="error">
                                @if (!run.IsSuccess)
                                {
                                    @if (run.FailureType == ScrapeFailureType.AbnormalCount)
                                    {
                                        <div>件数異常 / @run.AbnormalCountReason</div>
                                    }
                                    else
                                    {
                                        <div>@run.FailureType</div>
                                    }
                                    <div>@(run.FailureReason ?? "")</div>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </section>
    </div>
</main>
</body>
</html>
