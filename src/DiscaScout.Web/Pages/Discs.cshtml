@page "/discs"
@model DiscsModel
@using DiscaScout.Core
@{
    ViewData["Title"] = "DiscaScout CD一覧";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<!doctype html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { font-family: system-ui, -apple-system, "Segoe UI", sans-serif; color: #20242a; }
        body { margin: 0; background: #f6f7f9; }
        main { max-width: 1320px; margin: 0 auto; padding: 24px 28px; }
        nav { display: flex; gap: 14px; margin-bottom: 18px; font-size: 14px; }
        nav a { color: #165dce; text-decoration: none; }
        h1 { margin: 0 0 14px; font-size: 28px; }
        .tabs { display: flex; gap: 8px; margin-bottom: 14px; }
        .tabs a { padding: 9px 13px; border-radius: 7px; background: #e8ebef; color: #273142; text-decoration: none; font-weight: 650; }
        .tabs a.active { background: #273142; color: white; }
        .filters { display: flex; gap: 10px; align-items: end; background: white; border: 1px solid #dfe3e8; border-radius: 9px; padding: 12px; margin-bottom: 14px; }
        label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 650; }
        input[type=text], select { padding: 8px; border: 1px solid #c9ced6; border-radius: 6px; background: white; }
        input[type=text] { width: 340px; }
        button { border: 0; border-radius: 6px; padding: 8px 12px; background: #273142; color: white; font-weight: 650; cursor: pointer; }
        button.secondary { background: #5f6b7a; }
        button.rented { background: #7b3fa1; }
        .status { margin-bottom: 14px; padding: 10px 12px; background: #eef4ff; border: 1px solid #cbdcff; border-radius: 7px; }
        .disc-list { display: flex; flex-direction: column; gap: 8px; }
        .disc { display: grid; grid-template-columns: 92px minmax(0,1fr) auto; gap: 14px; min-height: 118px; background: white; border: 1px solid #dfe3e8; border-radius: 8px; padding: 10px; }
        .jacket { width: 92px; height: 92px; object-fit: contain; background: #f0f2f5; border-radius: 5px; }
        .no-image { width: 92px; height: 92px; display: grid; place-items: center; background: #eef0f3; color: #858d98; font-size: 11px; border-radius: 5px; }
        .title { font-size: 17px; font-weight: 750; margin-bottom: 4px; }
        .artist { font-size: 14px; margin-bottom: 6px; }
        .meta { color: #68707c; font-size: 12px; line-height: 1.6; }
        .badges { display: flex; gap: 5px; flex-wrap: wrap; margin: 5px 0; }
        .badge { font-size: 10px; font-weight: 750; padding: 3px 6px; border-radius: 999px; background: #e9edf2; }
        .badge.reason { background: #fff0cc; }
        .badge.pickup { background: #e8dcff; }
        .badge.rented { background: #e5f6ea; }
        .badge.archived { background: #f2dede; }
        .actions { display: flex; flex-direction: column; gap: 6px; align-items: stretch; min-width: 112px; }
        .actions form { margin: 0; }
        .actions button, .actions a { width: 100%; box-sizing: border-box; text-align: center; }
        .actions a { display: block; padding: 8px 10px; border-radius: 6px; border: 1px solid #c9ced6; color: #273142; text-decoration: none; font-size: 12px; }
        .pager { display: flex; justify-content: space-between; margin-top: 16px; color: #68707c; font-size: 13px; }
        .pager a { color: #165dce; text-decoration: none; }
    </style>
</head>
<body>
<main>
    <nav><a href="/discs">CD一覧</a><a href="/artists">Artist設定</a><a href="/operations">運用</a></nav>
    <h1>CD一覧</h1>

    <div class="tabs">
        <a class="@(Model.Tab == "unchecked" ? "active" : "")" asp-page="/Discs" asp-route-tab="unchecked">未チェック @Model.UncheckedCount</a>
        <a class="@(Model.Tab == "pickup" ? "active" : "")" asp-page="/Discs" asp-route-tab="pickup">★ ピックアップ @Model.PickupCount</a>
        <a class="@(Model.Tab == "all" ? "active" : "")" asp-page="/Discs" asp-route-tab="all">全件</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="status">@Model.StatusMessage</div>
    }

    <form method="get" class="filters">
        <input type="hidden" name="tab" value="@Model.Tab" />
        <label>検索<input type="text" name="q" value="@Model.Search" placeholder="タイトル・アーティスト" /></label>
        <label>レンタル状態
            <select name="rental">
                <option value="all" selected="@(Model.Rental == "all")">すべて</option>
                <option value="unrented" selected="@(Model.Rental == "unrented")">未レンタル</option>
                <option value="rented" selected="@(Model.Rental == "rented")">借りた</option>
            </select>
        </label>
        <label>並び順
            <select name="sort">
                <option value="updated" selected="@(Model.Sort == "updated")">更新が新しい順</option>
                <option value="rental" selected="@(Model.Sort == "rental")">レンタル開始日順</option>
                <option value="title" selected="@(Model.Sort == "title")">タイトル順</option>
                <option value="artist" selected="@(Model.Sort == "artist")">アーティスト順</option>
            </select>
        </label>
        <label>件数
            <select name="size" id="page-size">
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
                <option value="200" selected="@(Model.PageSize == 200)">200</option>
            </select>
        </label>
        <button type="submit">適用</button>
    </form>

    <div class="disc-list">
    @foreach (var disc in Model.Items)
    {
        var pickupArtists = DiscsModel.GetPickupArtists(disc);
        <article class="disc">
            <div>
                @if (!string.IsNullOrWhiteSpace(disc.ImagePath))
                {
                    <img class="jacket" src="/disc-image/@disc.Id" alt="" loading="lazy" />
                }
                else
                {
                    <div class="no-image">NO IMAGE</div>
                }
            </div>
            <div>
                <div class="title">@disc.Title</div>
                <div class="artist">@disc.Artist</div>
                <div class="badges">
                    @foreach (var reason in disc.ReviewReasons)
                    {
                        <span class="badge reason">@reason.Reason</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(pickupArtists)) { <span class="badge pickup">★ @pickupArtists</span> }
                    @if (disc.IsRented) { <span class="badge rented">借りた</span> }
                    @if (disc.IsArchived) { <span class="badge archived">ARCHIVED</span> }
                </div>
                <div class="meta">
                    @disc.GenreLarge @if (!string.IsNullOrWhiteSpace(disc.GenreMiddle)) { <text> / @disc.GenreMiddle</text> }
                    <br />レンタル開始: @(disc.RentalStartDate?.ToString("yyyy-MM-dd") ?? "-") / DISCAS ID: @disc.DiscasId
                </div>
            </div>
            <div class="actions">
                <a href="@disc.ProductUrl" target="_blank" rel="noopener noreferrer">DISCAS</a>
                @if (disc.NeedsReview && !disc.IsRented)
                {
                    <form method="post" asp-page-handler="Reviewed"><input type="hidden" name="id" value="@disc.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button type="submit">確認済み</button></form>
                }
                else if (!disc.IsRented)
                {
                    <form method="post" asp-page-handler="Reopen"><input type="hidden" name="id" value="@disc.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button class="secondary" type="submit">未チェックへ</button></form>
                }
                @if (!disc.IsRented)
                {
                    <form method="post" asp-page-handler="Rented"><input type="hidden" name="id" value="@disc.Id" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button class="rented" type="submit">借りた</button></form>
                }
            </div>
        </article>
    }
    </div>

    <div class="pager">
        <span>@Model.TotalCount 件 / @Model.PageNumber / @Model.TotalPages ページ</span>
        <span>
            @if (Model.PageNumber > 1)
            {
                <a asp-page="/Discs" asp-route-tab="@Model.Tab" asp-route-q="@Model.Search" asp-route-rental="@Model.Rental" asp-route-sort="@Model.Sort" asp-route-size="@Model.PageSize" asp-route-p="@(Model.PageNumber - 1)">← 前</a>
            }
            @if (Model.PageNumber < Model.TotalPages)
            {
                <text>&nbsp;&nbsp;</text><a asp-page="/Discs" asp-route-tab="@Model.Tab" asp-route-q="@Model.Search" asp-route-rental="@Model.Rental" asp-route-sort="@Model.Sort" asp-route-size="@Model.PageSize" asp-route-p="@(Model.PageNumber + 1)">次 →</a>
            }
        </span>
    </div>
</main>
<script>
    const size = document.getElementById('page-size');
    const saved = localStorage.getItem('discascout-page-size');
    if (saved && !location.search.includes('size=')) size.value = saved;
    size.addEventListener('change', () => localStorage.setItem('discascout-page-size', size.value));
</script>
</body>
</html>
